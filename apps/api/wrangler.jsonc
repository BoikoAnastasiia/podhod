{
  "name": "podhod",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "podhod-db",
      "database_id": "PLACEHOLDER_SET_BY_OWNER", // replaced by the owner after `wrangler d1 create podhod-db`; local dev and tests do not use it
      "migrations_dir": "migrations"
    }
  ]
}
